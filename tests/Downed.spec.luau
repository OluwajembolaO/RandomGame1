local T = require("./lib/T")
local Configs = require("../src/shared/Configs")
local Downed = require("../src/shared/Rules/Downed")

local stats = Configs.Run.Crew

T.describe("Downed", function()
    T.it("downs instead of killing", function()
        local member = Downed.new(stats)
        T.falsy(Downed.damage(member, stats, 40))
        T.equal(member.health, stats.MaxHealth - 40)
        T.truthy(Downed.damage(member, stats, 500), "this hit downs them")
        T.equal(member.status, "Downed")
        T.equal(member.health, 0)
        T.equal(member.bleed, stats.BleedOutSeconds)
        T.falsy(Downed.damage(member, stats, 10), "no more damage while downed")
    end)

    T.it("bleeds out unless someone is reviving", function()
        local member = Downed.new(stats)
        Downed.damage(member, stats, 500)
        T.falsy(Downed.tick(member, stats.BleedOutSeconds, true), "reviving pauses the timer")
        T.equal(member.bleed, stats.BleedOutSeconds)
        T.falsy(Downed.tick(member, stats.BleedOutSeconds - 1, false))
        T.truthy(Downed.tick(member, 1, false), "bled out")
        T.equal(member.status, "Dead")
    end)

    T.it("revives to part health", function()
        local member = Downed.new(stats)
        Downed.damage(member, stats, 500)
        T.truthy(Downed.revive(member, stats))
        T.equal(member.status, "Alive")
        T.near(member.health, stats.MaxHealth * stats.ReviveHealthFraction)
        T.falsy(Downed.revive(member, stats), "can't revive someone standing")
    end)

    T.it("heals only the living, up to max", function()
        local member = Downed.new(stats)
        Downed.damage(member, stats, 30)
        Downed.heal(member, stats, 1000)
        T.equal(member.health, stats.MaxHealth)
        Downed.kill(member)
        Downed.heal(member, stats, 10)
        T.equal(member.health, 0)
        Downed.respawn(member, stats)
        T.equal(member.status, "Alive")
        T.equal(member.health, stats.MaxHealth)
    end)

    T.it("calls a wipe when nobody is standing", function()
        local a, b = Downed.new(stats), Downed.new(stats)
        T.falsy(Downed.isWipe({ a, b }))
        Downed.damage(a, stats, 500)
        T.falsy(Downed.isWipe({ a, b }), "one still up")
        Downed.kill(b)
        T.truthy(Downed.isWipe({ a, b }))
        T.falsy(Downed.isWipe({}), "an empty crew isn't a wipe")
    end)
end)
